# Public address of this site (used for links and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Android package name of the SplitEase app.
NEXT_PUBLIC_ANDROID_PACKAGE=com.lambrk.splitease

# Where visitors without the app are sent. Leave empty to use the default,
# https://appverse.bitknob.com/android/splitease (there is no Play Store listing).
NEXT_PUBLIC_APK_URL=

# SplitEase backend, called from the server (email verification, iOS updates, admin dashboard).
# Give the address only, e.g. https://api.example.com. A trailing /api/v1 is accepted and ignored.
API_URL=http://localhost:9890

# Optional: SHA-256 fingerprints (comma separated) of the app's signing certificate. When set,
# /.well-known/assetlinks.json is served so Android can verify the website's app links.
ANDROID_SHA256_CERT_FINGERPRINTS=
