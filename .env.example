# Public address of this site (used for links and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Android package name of the SplitEase app.
NEXT_PUBLIC_ANDROID_PACKAGE=com.lambrk.splitease

# Direct link to the latest Android APK, e.g. https://splitease.lambrk.com/downloads/splitease.apk
# (put the file in public/downloads/). Leave empty until one is published.
NEXT_PUBLIC_APK_URL=

# SplitEase backend, called from the server only for email verification and iOS updates.
API_URL=http://localhost:9890

# Optional: SHA-256 fingerprints (comma separated) of the app's signing certificate. When set,
# /.well-known/assetlinks.json is served so Android can verify the website's app links.
ANDROID_SHA256_CERT_FINGERPRINTS=
